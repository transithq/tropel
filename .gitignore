# ── Rust / Cargo ──────────────────────────────────────────────
target/
**/*.rs.bk

# Cargo.lock is committed for this binary application,
# so it is NOT ignored here.

# ── IDE / Editors ─────────────────────────────────────────────
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
*.orig
.Directory
.fleet/
.history/

# ── OS cruft ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ── Tropel output / reports ───────────────────────────────────
*.csv
*.json
# The e2e smoke fixture is committed despite the *.json rule above.
!.github/ci/www/ok.json
!examples/collections/
# npm package manifests and the OpenAPI sample must be TRACKED despite the
# *.json rule: CI's wasm-slice job does `cd packages/exec-wasm && npm install`
# and the sample e2e job runs the OpenAPI fixture — the blanket rule silently
# excluded them (CI failed with ENOENT: package.json).
!packages/exec-wasm/package.json
!packages/exec-wasm/tsconfig.json
!packages/shims/package.json
!examples/openapi/working_api.json
results/
output/

# ── Environment & secrets ─────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# ── Node / JS vendored deps ───────────────────────────────────
node_modules/
js/node_modules/

# ── Python tooling ────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── Logs ──────────────────────────────────────────────────────
*.log
*.trace

# ── Build artifacts (outside target/) ─────────────────────────
*.o
*.so
*.dylib
*.dll
*.exe
*.pdb

# ── Benchmark data ────────────────────────────────────────────
benches/**/output/
benches/**/results/
**/*.bench

# ── CI / temporary ────────────────────────────────────────────
tmp/
temp/

# ── Backlog docs — local only, never tracked (avoids CI churn) ─
/TROPEL_BACKLOG_V2.md
/TROPEL_BACKLOG_V2_X.md
